{
  "name": "axion",
  "version": "0.0.1",
  "private": true,
  "description": "General-contractor CAP agent: hires, escrows, verifies and composes other CROO agents",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "slice": "node --env-file=.env --import tsx src/slice.ts",
    "serve": "node --env-file=.env --import tsx src/serve.ts",
    "arena": "node --env-file=.env --import tsx src/arena/run.ts",
    "bet-slice": "node --env-file=.env --import tsx src/arena/bet-slice.ts",
    "competitor:preview": "node --import tsx src/arena/competitor-preview.ts",
    "competitor": "node --env-file=.env --import tsx src/arena/competitor.ts",
    "arena-server": "node --env-file=.env --import tsx src/arena/server.ts",
    "arena-server:prod": "node --import tsx src/arena/server.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.104.1",
    "@croo-network/sdk": "^0.2.1",
    "ethers": "^6.13.0",
    "tsx": "^4.19.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=18"
  }
}
