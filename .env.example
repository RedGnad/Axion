# CROO SDK (issue the SDK-Key in the CROO Dashboard, not the SDK)
CROO_API_URL=https://api.croo.network
CROO_WS_URL=wss://api.croo.network/ws
CROO_SDK_KEY=croo_sk_...
# Optional custom Base RPC for balance checks (defaults to https://mainnet.base.org)
BASE_RPC_URL=https://mainnet.base.org

# LLM for the planner (decompose goal -> subtasks). Use the latest Claude model.
ANTHROPIC_API_KEY=sk-ant-...
