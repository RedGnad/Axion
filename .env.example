# ── CROO core ─────────────────────────────────────────────────────────────
CROO_API_URL=https://api.croo.network
CROO_WS_URL=wss://api.croo.network/ws
ANTHROPIC_API_KEY=            # LLM rationale (optional: without it, deterministic estimate)

# Arena buyer that hires REMOTE community racers (falls back to CROO_SDK_KEY if unset)
ARENA_SDK_KEY=
# The main Axion agent's provider key (serves the consensus-forecast service)
CROO_SDK_KEY=
AXION_SERVICE_ID=            # serviceId of the "ETH Move Forecast — Arena Consensus" service
AXION_RACE_ENGINE_SERVICE_ID= # optional free "Axion Race Engine Kit" onboarding service
AXION_BENCHMARK_SERVICE_ID=   # paid credential mint service

# ── The 3 persona agents (buyers/racers AND callable forecast providers) ───
COMPETITOR_BULL_SDK_KEY=      # Slicer  (momentum)
COMPETITOR_BEAR_SDK_KEY=      # Tanker  (contrarian value)
COMPETITOR_QUANT_SDK_KEY=     # Wizord  (microstructure)
COMPETITOR_BULL_SERVICE_ID=   # Slicer forecast service  (alias: SLICER_SERVICE_ID)
COMPETITOR_BEAR_SERVICE_ID=   # Tanker forecast service  (alias: TANKER_SERVICE_ID)
COMPETITOR_QUANT_SERVICE_ID=  # Wizord forecast service  (alias: WIZORD_SERVICE_ID)

# ── On-chain payments + betting (house EOA) ───────────────────────────────
BASE_RPC_URL=https://mainnet.base.org
HOUSE_EOA_ADDRESS=           # custodial house wallet for human USDC bets
HOUSE_EOA_PRIVATE_KEY=
HOUSE_MAX_BET_USDC=1
BOOKMAKER_RAKE_BPS=300       # 3% house
WINNER_RAKE_BPS=200          # 2% winning agent (bettor-funded)
BET_DECAY_FRACTION=0.78      # USDC bets close at this fraction of the reveal window
BET_MIN_MULTIPLIER=1.25      # lowest displayed real-bet odds before close
# Winning-agent payout: leave persona payouts UNSET (paying our own = wash). External
# agents give a payout address at join. Only set these to pay a specific persona:
# ARENA_PAYOUT_SLICER=
# ARENA_PAYOUT_TANKER=
# ARENA_PAYOUT_WIZORD=

# ── Persistence (durable state across restarts) ───────────────────────────
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
ARENA_HISTORY_FILE=arena-history.json
ARENA_SEED_FILE=arena-seed.json

# ── Rounds: cadence, cost caps, windows ───────────────────────────────────
ARENA_AUTO_ROUND_MS=43200000 # scheduled "next race" cadence (0 = off). 43.2M = 12h
ARENA_MIN_ROUND_MS=600000    # min gap between rounds (anti spam-burn), default 10m
ARENA_DAILY_RACES=2          # bounded free races/day from treasury (resets UTC)
ARENA_DAILY_THESIS_RACES=1   # daily cap for the 15m "long race"
ARENA_DISABLED_RACER_SERVICE_IDS= # comma-separated serviceIds temporarily removed from the grid
ARENA_WINDOW_SECONDS=60      # blitz race horizon
ARENA_THESIS_WINDOW_SECONDS=900
ARENA_AUTORUN=0              # 1 = run a round on boot
ARENA_ROUNDS=1              # rounds for the `npm run arena` CLI

# ── Live data sourcing / discovery / DQ ───────────────────────────────────
ARENA_LIVE_SOURCING=1        # personas source providers live from the store (rotation)
DISCOVERY_MAX_PRICE_USDC=0.10
ARENA_MAX_RACER_PRICE_USDC=0.01 # max paid to an external racer per round; keep at CROO min
ARENA_ESTIMATE_GRACE_SECONDS=45
ARENA_ESTIMATE_HARDCAP_SECONDS=300
ARENA_PROVIDER_EXPLORATION_RATE=0.2
ARENA_PROVIDER_HEALTH_HALFLIFE_MS=86400000
ARENA_PROVIDER_SLOW_MS=8000

# ── Onboarding ────────────────────────────────────────────────────────────
ALLOW_AGENT_SUBMIT=1         # allow community agents to join via /api/competitor

# ── App / misc ────────────────────────────────────────────────────────────
FRONTEND_URL=https://axion-fawn.vercel.app   # runner GET / redirects here
PORT=8787                    # injected by Render in prod

# ── Optional: legacy leaf services (roster.ts) ────────────────────────────
# LEAF_PRICE_SERVICE_ID=
# LEAF_CONTEXT_SERVICE_ID=
# LEAF_SUMMARIZE_SERVICE_ID=

# ── web/ (Vercel) ─────────────────────────────────────────────────────────
# NEXT_PUBLIC_RUNNER_URL=https://axion-arena.onrender.com
